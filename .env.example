# ------------------------------------------------------------------
# Assistant Craft Tool — environment variables
# Copy this file to `.env.local` for local dev,
# or upload as `.env` to your Combell Node.js account.
# ------------------------------------------------------------------

# --- Database (MySQL on your Combell Linux account) ---
# Combell gives you these in mijn.combell.com → Databases
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Use SSL if your Combell plan enforces it (normally false on internal host)
DB_SSL=false

# --- Auth (Google OAuth — protects the entire app) ---
# Generate with: `openssl rand -base64 32`
AUTH_SECRET=change-me-to-a-long-random-string
# Create at https://console.cloud.google.com → APIs & Services → Credentials
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret
# Comma-separated admin emails (full app + admin panel access)
ADMIN_EMAILS=mcc@about-us.be,dev@mail-us.be
# Training logins use synthetic emails ending in @temp.training.local internally — do not list those in ADMIN_EMAILS.
# Optional: parent domain (e.g. .gobonkerswithus.be) so the session cookie is shared with
# another app on a sibling subdomain. Not needed if everything (including the knowledge base
# at /ai-for-marketeers) is served from the same host.
# AUTH_COOKIE_DOMAIN=.gobonkerswithus.be

# --- AI / LLM (one key per client tenant) ---
# Get keys at https://platform.openai.com/api-keys
OPENAI_API_KEY__DEMO=sk-...
OPENAI_API_KEY__MAXI_ZOO=sk-...
# Optional fallback if a tenant-specific key is not set:
OPENAI_API_KEY=sk-...

# --- App ---
# Set this to your public URL in production (used for absolute URLs / logging)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production example:
# NEXT_PUBLIC_APP_URL=https://assistant-builder.gobonkerswithus.be
NODE_ENV=development
